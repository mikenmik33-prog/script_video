# Скопіюйте цей файл у .env і за потреби заповніть ключі.
# Поки ключі порожні - застосунок автоматично працює в DEMO-режимі
# (локальні тестові сценарій/візуал/озвучка, без платних API).

# Безкоштовний ключ для сценарію (Gemini): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Безкоштовний ключ для трендових ідей з YouTube (Google Cloud Console ->
# увімкнути "YouTube Data API v3" -> створити API-ключ):
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Платний ключ для оживлення окремих сцен рухом (fal.ai, оплата за
# фактичне використання без підписки): https://fal.ai/dashboard/keys
FAL_API_KEY=

# Безкоштовний ключ для генерації картинок сцен БЕЗ водяного знаку
# (Hugging Face Inference API, модель FLUX.1-schnell) - єдине джерело
# візуалу (без нього генеруються лише тестові заглушки). Зареєструйтесь
# на https://huggingface.co/join, тоді створіть токен (Read достатньо)
# на https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

OPENAI_API_KEY=
VIDEO_API_KEY=
TTS_API_KEY=
