# Скопіюйте цей файл у .env і за потреби заповніть ключі.
# Заповніть ключі перед запуском. Без ключів застосунок не використовує
# локальні підміни та повертає помилку конфігурації.

# Безкоштовний ключ для сценарію (Gemini): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Безкоштовний ключ для трендових ідей з YouTube (Google Cloud Console ->
# увімкнути "YouTube Data API v3" -> створити API-ключ):
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

OPENAI_API_KEY=
TTS_API_KEY=

